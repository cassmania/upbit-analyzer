# 값은 Vercel 서버 환경 변수에만 등록한다. 프런트엔드용 접두어를 붙이지 않는다.
PRIVATE_APP_ORIGIN=https://upbit-analyzer.vercel.app
PRIVATE_SUPABASE_URL=
PRIVATE_SUPABASE_ANON_KEY=
PRIVATE_OWNER_ID=
PRIVATE_OWNER_EMAIL=
# 무작위 32바이트를 64자리 16진수로 표현한 서버 전용 키
PRIVATE_ENCRYPTION_KEY=
# 실매매 전역 차단. "1"이면 trade.js의 live 주문이 전부 거부된다 (기본 모의에는 영향 없음)
# TRADE_KILL_SWITCH=0
